#$(module_prefix)_new
# 使用数据模板生成实体对象
# 输入数据模板storage $(project_name):io input
# 输入执行位置
# 输出 @e[tag=result,limit=1]

tag @e[tag=result] remove result
summon interaction ~ ~ ~ {Tags:["$(project_name)_$(module_name)","vve_cube_box","vve_material_box","vve_impulse_receiver","result"],data:{impulse_receiver:[]},Passengers:[{id:"minecraft:item_display",Tags:["$(project_name)_$(module_name)_display"],CustomName:"$(project_name)_$(module_name)_display",item_display:"fixed",teleport_duration:1,interpolation_duration:1,brightness:{sky:15,block:15},Passengers:[{id:"minecraft:interaction",Tags:["$(project_name)_$(module_name)_interaction"]}]}]}
execute as @e[tag=result,limit=1] run function $(module_prefix)set
execute as @e[tag=result,limit=1] run function $(module_prefix)set_operation