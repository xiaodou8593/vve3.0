#$(module_prefix)test/inter_bounce/frame

tellraw @a "---"
tellraw @a "frame: (frame)"
data modify storage $(project_name):io input set from storage $(project_name):io test_frames.(frame)
function $(module_prefix)_new
execute as @e[tag=result,limit=1] run function marker_control:data/_get
# 设置销毁函数
data modify storage marker_control:io result.del_func set value "$(module_prefix)_del"
execute as @e[tag=result,limit=1] run function marker_control:data/_store
tag @e[tag=result,limit=1] add entity_todel
scoreboard players set @e[tag=result,limit=1] killtime 50
execute as @e[tag=result,limit=1] run function $(module_prefix)main